<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Version>0.3.1</Version>

		<RepositoryUrl>https://github.com/MihomoManager/MihomoManager.MihomoMixin.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageRequireLicenseAcceptance>False</PackageRequireLicenseAcceptance>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<Authors>yueyinqiu</Authors>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Jint" Version="4.16.3" />
		<PackageReference Include="SharpYaml" Version="3.13.1" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Js/js-yaml.umd.min.js" />
	</ItemGroup>

</Project>
